#compdef theme

local -a raw themes
local theme

# Only complete the first argument to `theme`.
(( CURRENT == 2 )) || return 0

if (( $+commands[ghostty] )); then
    # Prefer the action name supported by current Ghostty releases.
    raw=("${(@f)$(ghostty +list-themes 2>/dev/null)}")
fi

for theme in "${raw[@]}"; do
    # Ghostty prints entries like: "Aardvark Blue (resources)"
    theme="${theme%% \(*}"
    [[ -n $theme ]] && themes+=("$theme")
done

# Fallback if Ghostty isn't available or returned nothing.
if (( ! ${#themes} )); then
    themes=($HOME/.config/ghostty/themes/*(:tN))
fi

typeset -U themes
compadd -- "${themes[@]}"

