#!/bin/sh

# Derive tmux pane colors from the selected Ghostty theme.
# Adjust this value to change the inactive-pane tint.
TMUX_THEME_TINT=0.12

THEME=${1:-}
if [ -z "$THEME" ]; then
  printf '%s\n' 'usage: tmux-sync-ghostty-theme THEME' >&2
  exit 2
fi

GHOSTTY_CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/ghostty
TMUX_THEME_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/tmux/theme.conf
MAIN_CONFIG=$GHOSTTY_CONFIG_DIR/config

find_theme_file() {
  theme=$1
  for candidate in \
    "$GHOSTTY_CONFIG_DIR/themes/$theme" \
    "/Applications/Ghostty.app/Contents/Resources/themes/$theme" \
    "/opt/homebrew/share/ghostty/themes/$theme" \
    "/usr/local/share/ghostty/themes/$theme" \
    "/usr/share/ghostty/themes/$theme"; do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

read_config_value() {
  key=$1
  file=$2
  if [ "$file" != "-" ] && [ ! -f "$file" ]; then
    return 0
  fi

  awk -v key="$key" '
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      value = $0
      sub(/^[^=]*=[[:space:]]*/, "", value)
      sub(/[[:space:]]+$/, "", value)
      result = value
    }
    END { if (result != "") print result }
  ' "$file" | tail -n 1
}

normalize_color() {
  color=$1
  color=${color#\#}
  case "$color" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
      printf '#%s\n' "$color" | tr '[:upper:]' '[:lower:]'
      ;;
    *)
      return 1
      ;;
  esac
}

DEFAULTS=$(ghostty +show-config --default 2>/dev/null || true)
DEFAULT_BACKGROUND=$(printf '%s\n' "$DEFAULTS" | awk -F= '$1 ~ /^[[:space:]]*background[[:space:]]*$/ { value=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); print value }' | tail -n 1)
DEFAULT_FOREGROUND=$(printf '%s\n' "$DEFAULTS" | awk -F= '$1 ~ /^[[:space:]]*foreground[[:space:]]*$/ { value=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", value); print value }' | tail -n 1)

# Ghostty resolves built-in themes internally. Read the effective configuration
# first, then fall back to a directly readable custom theme file.
EFFECTIVE_CONFIG=$(ghostty +show-config 2>/dev/null || true)
THEME_BACKGROUND=$(printf '%s\n' "$EFFECTIVE_CONFIG" | read_config_value background -)
THEME_FOREGROUND=$(printf '%s\n' "$EFFECTIVE_CONFIG" | read_config_value foreground -)

THEME_FILE=$(find_theme_file "$THEME" || true)
FILE_BACKGROUND=$(read_config_value background "$THEME_FILE")
FILE_FOREGROUND=$(read_config_value foreground "$THEME_FILE")
[ -n "$THEME_BACKGROUND" ] || THEME_BACKGROUND=$FILE_BACKGROUND
[ -n "$THEME_FOREGROUND" ] || THEME_FOREGROUND=$FILE_FOREGROUND

# Main-config values override values supplied by the theme when Ghostty is
# unavailable or does not report an effective color.
MAIN_BACKGROUND=$(read_config_value background "$MAIN_CONFIG")
MAIN_FOREGROUND=$(read_config_value foreground "$MAIN_CONFIG")
[ -n "$MAIN_BACKGROUND" ] && THEME_BACKGROUND=$MAIN_BACKGROUND
[ -n "$MAIN_FOREGROUND" ] && THEME_FOREGROUND=$MAIN_FOREGROUND

BACKGROUND=$(normalize_color "${THEME_BACKGROUND:-$DEFAULT_BACKGROUND}") || {
  printf 'cannot resolve Ghostty background for theme: %s\n' "$THEME" >&2
  exit 1
}
FOREGROUND=$(normalize_color "${THEME_FOREGROUND:-$DEFAULT_FOREGROUND}") || {
  printf 'cannot resolve Ghostty foreground for theme: %s\n' "$THEME" >&2
  exit 1
}

COLORS=$(awk -v bg="$BACKGROUND" -v fg="$FOREGROUND" -v tint="$TMUX_THEME_TINT" '
  function hex_value(c,    digits, i, value) {
    digits = "0123456789abcdef"
    value = 0
    c = tolower(c)
    for (i = 1; i <= length(c); i++)
      value = value * 16 + index(digits, substr(c, i, 1)) - 1
    return value
  }
  function channel(color, offset) {
    return hex_value(substr(color, offset, 2))
  }
  function blended(a, b) {
    return int(a * (1 - tint) + b * tint + 0.5)
  }
  function color(r, g, b) {
    return sprintf("#%02x%02x%02x", r, g, b)
  }
  BEGIN {
    bg = substr(bg, 2)
    fg = substr(fg, 2)
    inactive_bg = color(blended(channel(bg, 1), channel(fg, 1)),
                         blended(channel(bg, 3), channel(fg, 3)),
                         blended(channel(bg, 5), channel(fg, 5)))
    inactive_fg = color(blended(channel(fg, 1), channel(bg, 1)),
                         blended(channel(fg, 3), channel(bg, 3)),
                         blended(channel(fg, 5), channel(bg, 5)))
    print inactive_fg " " inactive_bg
  }
')

INACTIVE_FOREGROUND=${COLORS%% *}
INACTIVE_BACKGROUND=${COLORS#* }

mkdir -p "${TMUX_THEME_FILE%/*}"
TEMP_FILE=$(mktemp "${TMUX_THEME_FILE}.XXXXXX") || exit 1
trap 'rm -f "$TEMP_FILE"' EXIT HUP INT TERM

cat >"$TEMP_FILE" <<EOF
# Generated by tmux-sync-ghostty-theme. Do not edit.
setw -g window-active-style fg=$FOREGROUND,bg=$BACKGROUND
setw -g window-style fg=$INACTIVE_FOREGROUND,bg=$INACTIVE_BACKGROUND
EOF

mv "$TEMP_FILE" "$TMUX_THEME_FILE"
trap - EXIT HUP INT TERM

if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  tmux source-file "$TMUX_THEME_FILE"
fi
