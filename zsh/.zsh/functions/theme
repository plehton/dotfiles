function theme {
    local COLORSCHEME=$1
    local ghostty_theme_cfg=$HOME/.config/ghostty/auto/theme.ghostty
    local current_scheme=$(< $HOME/.colorscheme 2>/dev/null)

    # Gather themes
    typeset -U themes
    themes=("${(@f)$(ghostty +list-themes 2>/dev/null | sed 's/ (resources)//')}")

    # If no argument provided, open fzf picker
    if [[ -z $COLORSCHEME ]]; then
        COLORSCHEME=$(printf '%s\n' "${themes[@]}" | fzf --prompt="Theme>")

        # If user cancelled fzf
        [[ -z $COLORSCHEME ]] && return 0
    fi

    # Given theme equals current > don't do anything
    if [[ "$current_scheme" == "$COLORSCHEME" ]]; then
        echo "'$COLORSCHEME' already in use."
        return 0
    fi

    print -r -- "$COLORSCHEME" >$HOME/.colorscheme

    # Update Ghostty config and reload
    if [[ -d $HOME/.config/ghostty ]]; then
        mkdir -p "${ghostty_theme_cfg:h}"
        print -r -- "theme = $COLORSCHEME" >"$ghostty_theme_cfg"
    fi
}
